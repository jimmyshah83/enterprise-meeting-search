# Azure AD / Microsoft Graph API credentials
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Used for application (daemon) permission flow
AZURE_CLIENT_SECRET=your-client-secret

# Used for delegated (user) permission flow
# Provide either client secret or certificate for confidential client
# Leave AZURE_CLIENT_SECRET set and configure redirect URI in your app registration
AZURE_REDIRECT_URI=http://localhost:8080

# Optional: path to a PKCS#12 / PEM certificate instead of a client secret
# AZURE_CLIENT_CERTIFICATE_PATH=/path/to/cert.pem
# AZURE_CLIENT_CERTIFICATE_PASSWORD=cert-password

# Graph API base URL (default is the public cloud)
GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
